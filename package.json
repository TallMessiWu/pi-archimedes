{
  "name": "@tallmessiwu/pi-session-name-early",
  "version": "1.0.0",
  "private": true,
  "description": "Name Pi sessions on first input, without replacing Pi's terminal title or progress",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/TallMessiWu/pi-archimedes.git"
  },
  "keywords": ["pi-package"],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test packages/session-name/src/index.test.mjs",
    "test:production": "node scripts/test-production.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.session-name.json"
  },
  "pi": {
    "extensions": ["packages/session-name/src/index.ts"],
    "skills": [],
    "prompts": [],
    "themes": []
  },
  "dependencies": {
    "@pi-archimedes/core": "file:packages/core"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "22.19.19",
    "typescript": "^6.0.0"
  }
}
